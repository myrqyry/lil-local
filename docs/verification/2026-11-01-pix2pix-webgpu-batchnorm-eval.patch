@@ -0,0 +1,62 @@
+import sys
+import unittest
+
+sys.path.insert(0, "rust-pix2pix-wgpu")
+import export_weights as ew
+
+
+class OfficialJunyanzKeyDetectionTests(unittest.TestCase):
+    def test_detects_official_generator_outer_block(self):
+        state = {"model.model.0.weight": object()}
+        self.assertEqual(ew.detect_root_prefix(state), "model")
+
+    def test_detects_dataparallel_official_generator_outer_block(self):
+        state = {"module.model.model.0.weight": object()}
+        self.assertEqual(ew.detect_root_prefix(state), "module.model")
+
+    def test_batchnorm_checkpoint_selects_folded_eval_mode(self):
+        state = {
+            "model.model.0.weight": object(),
+            "model.model.1.model.2.running_mean": object(),
+            "model.model.1.model.2.running_var": object(),
+        }
+        self.assertEqual(
+            ew.validate_runtime_normalization(state),
+            "batch_eval_folded",
+        )
+
+    def test_accepts_instancenorm_style_checkpoint_without_running_stats(self):
+        state = {"model.model.0.weight": object()}
+        ew.validate_runtime_normalization(state)
+
+    def test_detects_batchnorm_and_instancenorm_checkpoint_modes(self):
+        batch = {
+            "model.model.0.weight": object(),
+            "model.model.1.model.2.running_mean": object(),
+        }
+        instance = {"model.model.0.weight": object()}
+        self.assertEqual(ew.detect_normalization_mode(batch), "batch_eval_folded")
+        self.assertEqual(ew.detect_normalization_mode(instance), "instance")
+
+    def test_folds_batchnorm_eval_into_scale_and_shift(self):
+        gamma = ew.Float32Tensor.from_any([2.0, 4.0])
+        beta = ew.Float32Tensor.from_any([1.0, -1.0])
+        mean = ew.Float32Tensor.from_any([3.0, 5.0])
+        variance = ew.Float32Tensor.from_any([4.0, 9.0])
+        scale, shift = ew.fold_batch_norm_eval(gamma, beta, mean, variance, eps=1e-5)
+        expected_scale = [
+            2.0 / ((4.0 + 1e-5) ** 0.5),
+            4.0 / ((9.0 + 1e-5) ** 0.5),
+        ]
+        expected_shift = [
+            1.0 - 3.0 * expected_scale[0],
+            -1.0 - 5.0 * expected_scale[1],
+        ]
+        for actual, expected in zip(scale.buffer, expected_scale):
+            self.assertAlmostEqual(actual, expected, places=6)
+        for actual, expected in zip(shift.buffer, expected_shift):
+            self.assertAlmostEqual(actual, expected, places=6)
+
+
+if __name__ == "__main__":
+    unittest.main()
